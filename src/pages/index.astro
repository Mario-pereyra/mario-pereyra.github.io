---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Comando from '../components/Comando.astro';
import Icono from '../components/Icono.astro';
import Retrato from '../components/Retrato.astro';
import Simbolo from '../components/Simbolo.astro';
import TarjetaProyecto from '../components/TarjetaProyecto.astro';
import { ahoraMismo, aprendiendo, experiencia, ficha, formacion, idiomas, perfil, rumbo, sobreMi, tiposDeProyecto } from '../data/perfil';
import { areas, enAprendizaje, yaManejo } from '../data/stack';

const proyectos = (await getCollection('proyectos')).sort((a, b) => a.data.orden - b.data.orden);
const conteo = (tipo: string) => proyectos.filter((p) => p.data.tipo === tipo).length;
const filtros = [
	{ valor: 'todos', texto: 'todos', n: proyectos.length },
	...(['personal', 'familiar', 'universidad'] as const).map((t) => ({ valor: t, texto: tiposDeProyecto[t].toLowerCase(), n: conteo(t) })),
].filter((f) => f.n > 0);

// Las negritas de los textos (**así**) pasan a <strong>. Los textos son propios, no vienen del usuario.
const negritas = (texto: string) => texto.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
const trabajo = experiencia[0];

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'ProfilePage',
	dateModified: perfil.actualizado,
	mainEntity: {
		'@type': 'Person',
		name: perfil.nombre,
		alternateName: perfil.nombreCorto,
		url: Astro.site?.href,
		image: new URL('/og.png', Astro.site).href,
		description: perfil.descripcion,
		jobTitle: 'Consultor TOTVS Protheus',
		worksFor: { '@type': 'Organization', name: 'TOTVS Bolivia', legalName: 'Resultar Soluciones SRL' },
		alumniOf: { '@type': 'CollegeOrUniversity', name: 'Universidad NUR' },
		address: { '@type': 'PostalAddress', addressLocality: 'Santa Cruz de la Sierra', addressCountry: 'BO' },
		knowsAbout: ['TypeScript', 'Node.js', 'React', 'SQL', 'AdvPL', 'TOTVS Protheus', 'Model Context Protocol', 'Agentes de IA'],
		knowsLanguage: ['es', 'en'],
		sameAs: [perfil.enlaces.github, perfil.enlaces.linkedin],
	},
};
---

<Base titulo={`${perfil.nombre} · Desarrollador`} descripcion={perfil.descripcion} jsonLd={jsonLd}>
	<!-- Portada -->
	<section class="portada" id="inicio" data-archivo="inicio.md" aria-labelledby="titulo-portada">
		<div class="contenedor portada__rejilla">
			<div class="portada__texto">
				<p class="portada__prompt" aria-hidden="true">
					<span class="c-verde">mario@santa-cruz</span><span class="c-tenue">:</span><span class="c-azul">~</span><span
						class="c-tenue">$</span
					> whoami
				</p>
				<h1 id="titulo-portada" class="portada__nombre">
					<span>Mario Alberto</span>
					<span class="portada__apellido">Pereyra Justiniano</span>
				</h1>
				<p class="portada__rol">{perfil.rol}</p>
				<p class="portada__intro">{perfil.presentacion}</p>
				<p class="portada__ahora">
					<span class="c-azul">ahora</span><span class="c-tenue">:</span>{' '}
					<span class="escribe" style={`--letras:${perfil.ahora.length}`}>{perfil.ahora}</span><span class="cursor" aria-hidden="true"
					></span>
				</p>
				<div class="acciones portada__acciones">
					<a class="boton boton--principal" href="#proyectos">Ver proyectos <Simbolo nombre="flecha" /></a>
					<a class="boton" href={perfil.cv} download><Simbolo nombre="descargar" /> Descargar CV</a>
					<span class="portada__redes">
						<a class="boton-icono" href={perfil.enlaces.github} aria-label="GitHub" rel="me noopener"><Simbolo nombre="github" /></a>
						<a class="boton-icono" href={perfil.enlaces.linkedin} aria-label="LinkedIn" rel="me noopener"><Simbolo nombre="linkedin" /></a>
					</span>
				</div>
				<p class="disponible"><span class="disponible__punto" aria-hidden="true"></span> Abierto a oportunidades como desarrollador backend o full stack</p>
			</div>
			<div class="portada__retrato">
				<Retrato />
			</div>
		</div>

		<div class="contenedor">
			<dl class="ficha ventana" aria-label="Datos rápidos">
				<div class="ventana__barra ficha__barra" aria-hidden="true">
					<span class="puntos"><i></i><i></i><i></i></span>
					<span class="ventana__titulo">mario.yml</span>
				</div>
				<div class="ficha__filas">
					{
						ficha.map(([clave, valor, nota], i) => (
							<div class="ficha__fila">
								<span class="ficha__linea" aria-hidden="true">
									{i + 1}
								</span>
								<dt>
									{clave}
									<span class="c-tenue" aria-hidden="true">
										:
									</span>
								</dt>
								<dd>
									{valor}
									{nota && <span class="ficha__nota"># {nota}</span>}
								</dd>
							</div>
						))
					}
				</div>
			</dl>
		</div>
	</section>

	<!-- Sobre mí -->
	<section class="seccion" id="sobre-mi" data-archivo="sobre-mi.md" aria-labelledby="titulo-sobre-mi">
		<div class="contenedor sobre">
			<div class="sobre__texto revelar">
				<Comando orden="cat" argumento="sobre-mi.md" />
				<h2 class="seccion__titulo" id="titulo-sobre-mi">Sobre mí</h2>
				{sobreMi.map((parrafo) => <p set:html={negritas(parrafo)} />)}
				<div class="rumbo">
					<p class="rumbo__clave"><span class="c-tenue">$</span> echo $RUMBO</p>
					<p>{rumbo}</p>
				</div>
			</div>

			<aside class="ventana aprendo revelar" aria-labelledby="titulo-aprendo">
				<div class="ventana__barra">
					<span class="puntos" aria-hidden="true"><i></i><i></i><i></i></span>
					<span class="ventana__titulo">aprendiendo.md</span>
				</div>
				<div class="aprendo__cuerpo">
					<h3 id="titulo-aprendo" class="aprendo__titulo"><span class="c-tenue" aria-hidden="true">#</span> Lo que estoy aprendiendo</h3>
					<ol class="aprendo__lista">
						{
							aprendiendo.map((punto) => (
								<li>
									<strong>{punto.titulo}:</strong> {punto.texto}
								</li>
							))
						}
					</ol>
					<p class="aprendo__ahora">
						<span class="aprendo__marca">ahora mismo</span>
						{ahoraMismo}
					</p>
				</div>
			</aside>
		</div>
	</section>

	<!-- Experiencia -->
	<section class="seccion seccion--banda" id="experiencia" data-archivo="experiencia.md" aria-labelledby="titulo-experiencia">
		<div class="contenedor">
			<header class="seccion__cabecera revelar">
				<Comando orden="git log" argumento='--author="mario"' />
				<h2 class="seccion__titulo" id="titulo-experiencia">Experiencia</h2>
			</header>

			<article class="trabajo ventana revelar">
				<div class="ventana__barra">
					<span class="puntos" aria-hidden="true"><i></i><i></i><i></i></span>
					<span class="ventana__titulo">{trabajo.organizacion.toLowerCase().replace(' ', '-')} · desde {trabajo.inicio}</span>
					<span class="trabajo__head" aria-hidden="true">HEAD → main</span>
				</div>
				<div class="trabajo__cuerpo">
					<div class="trabajo__cabecera">
						<div>
							<h3 class="trabajo__puesto">{trabajo.puesto}</h3>
							<p class="trabajo__empresa">
								{trabajo.organizacion} <span class="c-tenue">({trabajo.razonSocial})</span>
							</p>
						</div>
						<p class="trabajo__fecha">
							<span>{trabajo.periodo}</span>
							<span>{trabajo.lugar}</span>
						</p>
					</div>
					<p class="trabajo__contexto">{trabajo.contexto}</p>

					<div class="puesto">
						<div class="puesto__celda">
							<p class="puesto__clave">módulos<span class="c-tenue">:</span></p>
							<ul class="modulos">
								{
									trabajo.modulos.map((m) => (
										<li>
											<code>{m.codigo}</code> {m.nombre}
										</li>
									))
								}
							</ul>
						</div>
						<div class="puesto__celda">
							<p class="puesto__clave">herramientas<span class="c-tenue">:</span></p>
							<ul class="iconos">
								{
									trabajo.herramientas.map((h) => (
										<li>
											<Icono id={h.id} nombre={h.nombre} />
										</li>
									))
								}
							</ul>
						</div>
					</div>

					<ul class="diff">
						{trabajo.logros.map((logro) => <li>{logro}</li>)}
					</ul>
				</div>
			</article>
		</div>
	</section>

	<!-- Proyectos -->
	<section class="seccion" id="proyectos" data-archivo="proyectos/" aria-labelledby="titulo-proyectos">
		<div class="contenedor">
			<header class="seccion__cabecera proyectos__cabecera revelar">
				<div>
					<Comando orden="ls" argumento="~/proyectos" />
					<h2 class="seccion__titulo" id="titulo-proyectos">Proyectos</h2>
					<p class="seccion__bajada">Lo que construí por mi cuenta, para el emprendimiento de mi familia y en la universidad. En los de equipo cuento solo mi parte.</p>
				</div>
				<div class="filtros" role="group" aria-label="Filtrar proyectos" data-filtros hidden>
					{
						filtros.map((f, i) => (
							<button type="button" class="filtro" data-filtro={f.valor} aria-pressed={i === 0 ? 'true' : 'false'}>
								{f.texto} <span class="filtro__n">{f.n}</span>
							</button>
						))
					}
				</div>
			</header>
			<ul class="proyectos" data-proyectos>
				{
					proyectos.map((p) => (
						<li data-tipo={p.data.tipo} data-id={p.id}>
							<TarjetaProyecto proyecto={p} />
						</li>
					))
				}
			</ul>
			<p class="visualmente-oculto" role="status" data-filtro-estado></p>
		</div>
	</section>

	<!-- Stack -->
	<section class="seccion seccion--banda" id="stack" data-archivo="stack.yaml" aria-labelledby="titulo-stack">
		<div class="contenedor">
			<header class="seccion__cabecera revelar">
				<Comando orden="cat" argumento="stack.yaml" />
				<h2 class="seccion__titulo" id="titulo-stack">Stack</h2>
				<p class="seccion__bajada">
					<code class="c-verde">ya_manejo</code> es nivel intermedio o avanzado; <code class="c-amarillo">aprendiendo</code>, básico. Pasa
					el cursor o enfoca un ícono para ver su nombre y nivel.
				</p>
			</header>

			<div class="stack ventana revelar" role="table" aria-label="Tecnologías por área y nivel">
				<div class="stack__fila stack__fila--titulos" role="row">
					<span role="columnheader"><span class="visualmente-oculto">Área</span></span>
					<span role="columnheader" class="c-verde">ya_manejo:</span>
					<span role="columnheader" class="c-amarillo">aprendiendo:</span>
				</div>
				{
					areas.map((a) => (
						<div class="stack__fila" role="row">
							<span class="stack__area" role="rowheader">
								{a.area}
								<span class="c-tenue">:</span>
							</span>
							<div role="cell" class="stack__celda" data-titulo="ya_manejo">
								<ul class="iconos">
									{yaManejo(a.items).map((i) => (
										<li>
											<Icono id={i.id} nombre={i.nombre} nivel={i.nivel} />
										</li>
									))}
								</ul>
							</div>
							<div role="cell" class="stack__celda" data-titulo="aprendiendo">
								{enAprendizaje(a.items).length > 0 && (
									<ul class="iconos">
										{enAprendizaje(a.items).map((i) => (
											<li>
												<Icono id={i.id} nombre={i.nombre} nivel={i.nivel} />
											</li>
										))}
									</ul>
								)}
								{a.conceptos && (
									<ul class="chips">
										{a.conceptos.map((c) => (
											<li class="chip">{c}</li>
										))}
									</ul>
								)}
							</div>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- Formación -->
	<section class="seccion" id="formacion" data-archivo="formacion.md" aria-labelledby="titulo-formacion">
		<div class="contenedor">
			<header class="seccion__cabecera revelar">
				<Comando orden="cat" argumento="formacion.md" />
				<h2 class="seccion__titulo" id="titulo-formacion">Formación</h2>
			</header>
			<div class="formacion">
				<article class="bloque bloque--ancho revelar">
					<p class="bloque__meta">{formacion.lugar}</p>
					<h3>{formacion.titulo}</h3>
					<p class="bloque__sub">{formacion.institucion} · {formacion.estado}</p>
					<p class="bloque__egreso">{formacion.egreso}</p>
					<p class="bloque__grado"><strong>Proyecto de grado (en curso):</strong> {formacion.proyectoDeGrado}</p>
				</article>
				<article class="bloque revelar">
					<p class="bloque__meta">idiomas</p>
					<h3>Idiomas</h3>
					<dl class="idiomas">
						{
							idiomas.map((i) => (
								<div>
									<dt>{i.idioma}</dt>
									<dd>{i.nivel}</dd>
								</div>
							))
						}
					</dl>
				</article>
			</div>
		</div>
	</section>

	<!-- Contacto -->
	<section class="seccion contacto" id="contacto" data-archivo="contactar.sh" aria-labelledby="titulo-contacto">
		<div class="contenedor contacto__rejilla">
			<div class="revelar">
				<Comando orden="./contactar.sh" />
				<h2 class="seccion__titulo contacto__titulo" id="titulo-contacto">¿Hablamos?</h2>
				<p class="contacto__texto">
					Estoy abierto a oportunidades como desarrollador backend o full stack. Si tu equipo cuida las buenas prácticas y trabaja cerca del
					cliente, me encantaría conversar.
				</p>
				<div class="acciones">
					<a class="boton boton--principal" href={perfil.enlaces.linkedin} data-enlace-correo><Simbolo nombre="correo" /> Escribirme un correo</a>
					<a class="boton" href={perfil.cv} download><Simbolo nombre="descargar" /> Descargar CV</a>
				</div>
			</div>

			<div class="ventana terminal revelar">
				<div class="ventana__barra">
					<span class="puntos" aria-hidden="true"><i></i><i></i><i></i></span>
					<span class="ventana__titulo">zsh · contactar.sh</span>
				</div>
				<dl class="terminal__cuerpo">
					<div class="terminal__fila">
						<dt><span class="c-verde" aria-hidden="true">→ </span>correo</dt>
						<dd>
							<a data-enlace-correo href={perfil.enlaces.linkedin}
								><span data-texto-correo>se muestra con JavaScript; también puedes escribirme por LinkedIn</span></a
							>
							<button class="copiar" type="button" data-copiar-correo hidden aria-label="Copiar el correo">
								<Simbolo nombre="copiar" />
							</button>
						</dd>
					</div>
					<div class="terminal__fila">
						<dt><span class="c-verde" aria-hidden="true">→ </span>linkedin</dt>
						<dd><a href={perfil.enlaces.linkedin} rel="me noopener">in/mario-pereyra-justiniano</a></dd>
					</div>
					<div class="terminal__fila">
						<dt><span class="c-verde" aria-hidden="true">→ </span>github</dt>
						<dd><a href={perfil.enlaces.github} rel="me noopener">mario-pereyra</a></dd>
					</div>
					<div class="terminal__fila">
						<dt><span class="c-verde" aria-hidden="true">→ </span>cv</dt>
						<dd><a href={perfil.cv} download>CV_Mario_Pereyra_Justiniano.pdf</a></dd>
					</div>
					<div class="terminal__fila">
						<dt><span class="c-verde" aria-hidden="true">→ </span>base</dt>
						<dd>{perfil.ubicacion} <span class="c-tenue">(UTC−4)</span></dd>
					</div>
				</dl>
				<p class="terminal__fin" aria-hidden="true"><span class="c-tenue">$</span> <span class="cursor"></span></p>
			</div>
		</div>
	</section>
</Base>

<style>
	/* Colores de sintaxis */
	.c-verde {
		color: var(--verde);
	}
	.c-azul {
		color: var(--azul);
	}
	.c-amarillo {
		color: var(--amarillo);
	}
	.c-tenue {
		color: var(--texto-3);
	}

	.cursor {
		display: inline-block;
		width: 0.6em;
		height: 1.15em;
		margin-left: 2px;
		vertical-align: -0.2em;
		background: var(--rosa);
	}

	@media (prefers-reduced-motion: no-preference) {
		.cursor {
			animation: parpadeo 1.1s steps(1) infinite;
		}
	}

	@keyframes parpadeo {
		50% {
			opacity: 0;
		}
	}

	/* ---------- Portada ---------- */

	.portada {
		padding-block: clamp(2.5rem, 7vw, 5.5rem) clamp(3rem, 6vw, 4.5rem);
	}

	.portada__rejilla {
		display: grid;
		gap: clamp(2.5rem, 6vw, 4.5rem);
		align-items: center;
	}

	@media (min-width: 60rem) {
		.portada__rejilla {
			grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.85fr);
		}
	}

	.portada__prompt {
		margin-bottom: 1.1rem;
		font-family: var(--mono);
		font-size: 0.9375rem;
	}

	.portada__nombre {
		display: flex;
		flex-direction: column;
		font-size: clamp(2.6rem, 7.2vw, 4.75rem);
		font-weight: 700;
		line-height: 1.02;
		letter-spacing: -0.035em;
	}

	.portada__apellido {
		color: var(--texto-3);
	}

	.portada__rol {
		margin-top: 1.1rem;
		font-family: var(--mono);
		font-size: clamp(0.9375rem, 1.6vw, 1.0625rem);
		color: var(--amarillo);
	}

	.portada__intro {
		max-width: 36rem;
		margin-top: 1rem;
		font-size: clamp(1.0625rem, 1.8vw, 1.25rem);
		line-height: 1.6;
		color: var(--texto-2);
	}

	.portada__ahora {
		margin-top: 1.25rem;
		font-family: var(--mono);
		font-size: 0.9375rem;
		color: var(--texto);
	}

	.escribe {
		display: inline-block;
		max-width: 100%;
		color: var(--verde);
		vertical-align: bottom;
		white-space: nowrap;
		overflow: hidden;
	}

	@media (prefers-reduced-motion: no-preference) {
		.escribe {
			width: calc(var(--letras) * 1ch);
			animation: escribir 2.6s steps(var(--letras)) 0.9s both;
		}
	}

	@keyframes escribir {
		from {
			width: 0;
		}
	}

	.portada__acciones {
		align-items: center;
		margin-top: 2rem;
	}

	.portada__redes {
		display: inline-flex;
		gap: 0.25rem;
		margin-left: 0.25rem;
	}

	.disponible {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		margin-top: 1.5rem;
		font-family: var(--mono);
		font-size: 0.8125rem;
		color: var(--texto-3);
	}

	.disponible__punto {
		position: relative;
		width: 0.55rem;
		height: 0.55rem;
		border-radius: 50%;
		background: var(--verde);
	}

	@media (prefers-reduced-motion: no-preference) {
		.disponible__punto::after {
			content: '';
			position: absolute;
			inset: 0;
			border-radius: 50%;
			background: var(--verde);
			animation: latido 2.4s ease-out infinite;
		}
	}

	@keyframes latido {
		from {
			opacity: 0.6;
			scale: 1;
		}
		to {
			opacity: 0;
			scale: 3;
		}
	}

	.portada__retrato {
		width: min(100%, 26rem);
		justify-self: center;
	}

	@media (min-width: 60rem) {
		.portada__retrato {
			justify-self: end;
		}
	}

	/* mario.yml */
	.ficha {
		margin: clamp(2.5rem, 6vw, 4rem) 0 0;
	}

	.ficha__barra {
		min-height: 2rem;
	}

	.ficha__filas {
		display: grid;
		padding: 0.6rem 0;
		font-family: var(--mono);
		font-size: 0.875rem;
	}

	@media (min-width: 48rem) {
		.ficha__filas {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	/* Número de línea, clave y valor; en pantallas chicas el valor baja, alineado con la clave. */
	.ficha__fila {
		display: grid;
		grid-template-columns: 2.75rem auto minmax(0, 1fr);
		align-items: baseline;
		gap: 0.15rem 0.6rem;
		padding: 0.3rem 1rem 0.3rem 0;
	}

	@media (max-width: 30rem) {
		.ficha__fila {
