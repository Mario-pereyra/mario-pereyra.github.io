<script>
	const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;

	// Filtro de proyectos, con una transición suave donde el navegador la soporta.
	const grupo = document.querySelector<HTMLElement>('[data-filtros]');
	const lista = document.querySelector<HTMLElement>('[data-proyectos]');
	const estado = document.querySelector<HTMLElement>('[data-filtro-estado]');
	if (grupo && lista) {
		grupo.hidden = false;
		const botones = [...grupo.querySelectorAll<HTMLButtonElement>('[data-filtro]')];
		const items = [...lista.querySelectorAll<HTMLElement>(':scope > li')];
		const aplicar = (valor: string) => {
			let n = 0;
			for (const item of items) {
				const ver = valor === 'todos' || item.dataset.tipo === valor;
				item.hidden = !ver;
				if (ver) n++;
			}
			for (const b of botones) b.setAttribute('aria-pressed', String(b.dataset.filtro === valor));
			if (estado) estado.textContent = `${n} ${n === 1 ? 'proyecto' : 'proyectos'}`;
		};
		for (const boton of botones) {
			boton.addEventListener('click', () => {
				const valor = boton.dataset.filtro ?? 'todos';
				if (!document.startViewTransition || quieto) return aplicar(valor);
				items.forEach((item) => (item.style.viewTransitionName = `tarjeta-${item.dataset.id}`));
				document.startViewTransition(() => aplicar(valor)).finished.finally(() => items.forEach((item) => (item.style.viewTransitionName = '')));
			});
		}
	}
</script>
