---
import Base from '../layouts/Base.astro';
import Simbolo from '../components/Simbolo.astro';
import { perfil } from '../data/perfil';
---

<Base titulo={`Página no encontrada · ${perfil.nombre}`} descripcion="La página que buscas no existe." archivo="[sin nombre]">
	<section class="error contenedor">
		<div class="ventana error__ventana">
			<div class="ventana__barra">
				<span class="puntos" aria-hidden="true"><i></i><i></i><i></i></span>
				<span class="ventana__titulo">vim</span>
			</div>
			<div class="error__cuerpo">
				<p class="error__codigo" aria-hidden="true">404</p>
				<h1>Esta página no existe</h1>
				<p class="error__texto">Puede que el enlace esté mal escrito o que la página se haya movido.</p>
				<p class="error__vim" aria-hidden="true"><span>E404:</span> no se encontró el archivo</p>
				<div class="acciones">
					<a class="boton boton--principal" href="/"><Simbolo nombre="atras" /> Volver al inicio</a>
					<button class="boton" type="button" data-abrir-paleta><Simbolo nombre="buscar" /> Buscar en la página</button>
				</div>
			</div>
		</div>
	</section>
</Base>

<style>
	.error {
		display: grid;
		place-items: center;
		min-height: 70dvh;
		padding-block: 3rem;
	}

	.error__ventana {
		width: min(100%, 36rem);
	}

	.error__cuerpo {
		display: grid;
		gap: 0.9rem;
		padding: 2rem;
	}

	.error__codigo {
		font-family: var(--mono);
		font-size: clamp(4rem, 14vw, 6.5rem);
		font-weight: 700;
		line-height: 1;
		color: var(--rosa);
	}

	h1 {
		font-size: 1.75rem;
	}

	.error__texto {
		color: var(--texto-2);
	}

	.error__vim {
		padding: 0.4rem 0.6rem;
		border-radius: 6px;
		background: var(--fondo-3);
		font-family: var(--mono);
		font-size: 0.8125rem;
		color: var(--texto-2);
	}

	.error__vim span {
		color: var(--rosa);
	}

	.acciones {
		margin-top: 0.5rem;
	}
</style>
