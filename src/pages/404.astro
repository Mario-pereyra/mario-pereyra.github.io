---
import Base from '../layouts/Base.astro';
import { perfil } from '../data/perfil';
---

<Base titulo={`Página no encontrada · ${perfil.nombre}`} descripcion="La página que buscas no existe.">
	<section class="portada contenedor">
		<p class="etiqueta">Error 404</p>
		<h1>Esta página no existe</h1>
		<p class="portada__intro">Puede que el enlace esté mal escrito o que la página se haya movido.</p>
		<div class="acciones">
			<a class="boton boton--principal" href="/">Ir al inicio</a>
		</div>
	</section>
</Base>
