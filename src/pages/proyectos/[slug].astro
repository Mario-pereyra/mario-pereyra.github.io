---
import { Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icono from '../../components/Icono.astro';
import Simbolo from '../../components/Simbolo.astro';
import { perfil, tiposDeProyecto } from '../../data/perfil';
import { iconoDe } from '../../data/stack';

export async function getStaticPaths() {
	const proyectos = (await getCollection('proyectos')).sort((a, b) => a.data.orden - b.data.orden);
	return proyectos.map((proyecto, i) => ({
		params: { slug: proyecto.id },
		props: { proyecto, anterior: proyectos[i - 1], siguiente: proyectos[i + 1] },
	}));
}

interface Props {
	proyecto: CollectionEntry<'proyectos'>;
	anterior?: CollectionEntry<'proyectos'>;
	siguiente?: CollectionEntry<'proyectos'>;
}

const { proyecto, anterior, siguiente } = Astro.props;
const { titulo, resumen, tipo, equipo, periodo, stack, aporte, demo, codigo, codigoPrivado, captura, capturaAlt } = proyecto.data;
const { Content } = await render(proyecto);
const tinta = { personal: 'rosa', familiar: 'amarillo', universidad: 'azul' }[tipo];
const conIcono = stack.filter((n) => iconoDe(n));
const sinIcono = stack.filter((n) => !iconoDe(n));
---

<Base titulo={`${titulo} · ${perfil.nombre}`} descripcion={resumen} archivo={`proyectos/${proyecto.id}.md`}>
	<article class="caso" style={`--tinta: var(--${tinta})`}>
		<div class="contenedor">
			<nav class="miga" aria-label="Ruta">
				<a href="/#proyectos"><Simbolo nombre="atras" /> <span class="c-azul">~/proyectos</span></a><span class="c-tenue">/</span><span
					aria-current="page">{proyecto.id}</span
				>
			</nav>

			<header class="caso__cabecera">
				<div class="caso__texto">
					<p class="caso__meta">
						<span class="etiqueta caso__tipo">{tiposDeProyecto[tipo]}{equipo && ` · ${equipo}`}</span>
						<span>{periodo}</span>
					</p>
					<h1 class="caso__titulo" style={`view-transition-name: proyecto-${proyecto.id}`}>{titulo}</h1>
					<p class="caso__resumen">{resumen}</p>
					<div class="acciones">
						{
							demo && (
								<a class="boton boton--principal" href={demo} rel="noopener">
									<Simbolo nombre="externo" /> Ver la demo
								</a>
							)
						}
						{
							codigo.map((c) => (
								<a class="boton" href={c.url} rel="noopener">
									<Simbolo nombre="codigo" /> {c.etiqueta === 'Código' ? 'Ver el código' : `Código: ${c.etiqueta.toLowerCase()}`}
								</a>
							))
						}
						{
							codigoPrivado && (
								<span class="etiqueta caso__privado">
									<Simbolo nombre="candado" /> el código todavía es privado
								</span>
							)
						}
					</div>
				</div>

				<div class="caso__vista" aria-hidden={captura ? undefined : 'true'}>
					{
						captura ? (
							<div class="celular">
								<Image src={captura} alt={capturaAlt ?? ''} widths={[280, 420, 560]} sizes="280px" loading="eager" />
							</div>
						) : (
							<ul class="caso__arte">
								{conIcono.slice(0, 6).map((n) => (
									<li>
										<img src={`/iconos/${iconoDe(n)}-oscuro.svg`} alt="" width="48" height="48" />
									</li>
								))}
							</ul>
						)
					}
				</div>
			</header>

			<div class="caso__rejilla">
				<section class="caso__aporte" aria-labelledby="titulo-aporte">
					<h2 id="titulo-aporte" class="caso__subtitulo">{equipo ? 'Mi parte' : 'Qué hice'}</h2>
					<ul class="diff">
						{aporte.map((punto) => <li>{punto}</li>)}
					</ul>
				</section>

				<aside class="caso__stack" aria-labelledby="titulo-stack">
					<h2 id="titulo-stack" class="caso__subtitulo">Tecnologías</h2>
					<ul class="iconos">
						{
							conIcono.map((n) => (
								<li>
									<Icono id={iconoDe(n)!} nombre={n} />
								</li>
							))
						}
					</ul>
					{
						sinIcono.length > 0 && (
							<ul class="chips">
								{sinIcono.map((n) => (
									<li class="chip">{n}</li>
								))}
							</ul>
						)
					}
				</aside>
			</div>

			<section class="ventana leeme" aria-label="Contexto y decisiones">
				<div class="ventana__barra">
					<span class="puntos" aria-hidden="true"><i></i><i></i><i></i></span>
					<span class="ventana__titulo">README.md</span>
				</div>
				<div class="prosa">
					<Content />
				</div>
			</section>

			<nav class="vecinos" aria-label="Otros proyectos">
				{
					anterior ? (
						<a class="vecino" href={`/proyectos/${anterior.id}/`}>
							<span class="vecino__dir">
								<Simbolo nombre="atras" /> anterior
							</span>
							<span class="vecino__titulo">{anterior.data.titulo}</span>
						</a>
					) : (
						<span />
					)
				}
				{
					siguiente && (
						<a class="vecino vecino--siguiente" href={`/proyectos/${siguiente.id}/`}>
							<span class="vecino__dir">
								siguiente <Simbolo nombre="flecha" />
							</span>
							<span class="vecino__titulo">{siguiente.data.titulo}</span>
						</a>
					)
				}
			</nav>
		</div>
	</article>
</Base>

<style>
	.c-azul {
		color: var(--azul);
	}
	.c-tenue {
		color: var(--texto-3);
	}

	.caso {
		padding-block: 2rem clamp(4rem, 8vw, 6rem);
	}

	.miga {
		display: flex;
		align-items: center;
		gap: 0.3rem;
		font-family: var(--mono);
		font-size: 0.875rem;
		color: var(--texto);
	}

	.miga a {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		min-height: 2.5rem;
		text-decoration: none;
	}

	.miga a:hover .c-azul {
		text-decoration: underline;
	}

	.miga :global(.simbolo) {
		width: 1rem;
		height: 1rem;
		color: var(--texto-3);
	}

	.caso__cabecera {
		display: grid;
		gap: 2.5rem;
		align-items: center;
		margin-top: 1.5rem;
		padding-bottom: 3rem;
		border-bottom: 1px solid var(--borde);
	}

	@media (min-width: 56rem) {
		.caso__cabecera {
			grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
		}
	}

	.caso__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 0.9rem;
		font-family: var(--mono);
		font-size: 0.8125rem;
		color: var(--texto-3);
	}

	.caso__tipo {
		border-color: color-mix(in srgb, var(--tinta) 50%, var(--borde));
		color: var(--texto);
	}

	.caso__titulo {
		margin-top: 1rem;
		font-size: clamp(2.4rem, 6vw, 3.75rem);
		font-weight: 700;
		letter-spacing: -0.03em;
	}

	.caso__resumen {
		max-width: 38rem;
		margin: 1rem 0 1.75rem;
		font-size: clamp(1.0625rem, 1.8vw, 1.25rem);
		color: var(--texto-2);
	}

	.caso__privado :global(.simbolo) {
		width: 0.9rem;
		height: 0.9rem;
	}

	.caso__vista {
		position: relative;
		height: 22rem;
		border: 1px solid var(--borde);
		border-radius: var(--radio);
		overflow: hidden;
		background-color: color-mix(in srgb, var(--tinta) 9%, var(--fondo-3));
		background-image: radial-gradient(color-mix(in srgb, var(--tinta) 45%, transparent) 1.1px, transparent 1.4px);
		background-size: 14px 14px;
	}

	.celular {
		position: absolute;
		left: 50%;
		top: 2rem;
		width: 15rem;
		translate: -50% 0;
		rotate: -3deg;
		padding: 7px;
		border-radius: 1.9rem 1.9rem 0 0;
		background: #111;
		box-shadow: 0 24px 50px -14px rgb(0 0 0 / 0.55);
	}

	.celular :global(img) {
		width: 100%;
		height: auto;
		border-radius: 1.45rem 1.45rem 0 0;
	}

	.caso__arte {
		position: absolute;
		inset: 0;
		display: grid;
		grid-template-columns: repeat(3, 4rem);
		place-content: center;
		gap: 1rem;
		list-style: none;
	}

	.caso__arte li {
		width: 4rem;
		height: 4rem;
		border-radius: 22%;
		box-shadow: 0 12px 26px -10px rgb(0 0 0 / 0.5);
	}

	.caso__arte li:nth-child(even) {
		translate: 0 0.75rem;
	}

	.caso__arte img {
		width: 100%;
		height: 100%;
	}

	.caso__rejilla {
		display: grid;
		gap: 2.5rem;
		padding-block: 3rem;
	}

	@media (min-width: 56rem) {
		.caso__rejilla {
			grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
			gap: 3.5rem;
		}
	}

	.caso__subtitulo {
		margin-bottom: 1rem;
		font-family: var(--mono);
		font-size: 0.875rem;
		font-weight: 600;
		letter-spacing: 0;
		text-transform: lowercase;
		color: var(--amarillo);
	}

	.caso__subtitulo::before {
		content: '## ';
		color: var(--texto-3);
	}

	.diff {
		display: grid;
		gap: 0.35rem;
		list-style: none;
	}

	.diff li {
		position: relative;
		padding: 0.6rem 0.9rem 0.6rem 2.2rem;
		border-radius: 6px;
		background: color-mix(in srgb, var(--verde) 9%, transparent);
		color: var(--texto-2);
	}

	.diff li::before {
		content: '+';
		position: absolute;
		left: 0.85rem;
		top: 0.6rem;
		font-family: var(--mono);
		font-weight: 700;
		color: var(--verde);
	}

	.caso__stack .chips {
		margin-top: 0.9rem;
	}

	.leeme {
		box-shadow: none;
	}

	.prosa {
		max-width: 46rem;
		padding: clamp(1.25rem, 3vw, 2rem) clamp(1.25rem, 3.5vw, 2.25rem);
		color: var(--texto-2);
	}

	.prosa :global(h2) {
		margin: 2rem 0 0.75rem;
		font-size: 1.25rem;
		color: var(--texto);
	}

	.prosa :global(h2:first-child) {
		margin-top: 0;
	}

	.prosa :global(h2)::before {
		content: '## ';
		font-family: var(--mono);
		font-size: 0.9em;
		color: var(--texto-3);
	}

	.prosa :global(p + p) {
		margin-top: 0.9rem;
	}

	.prosa :global(ul) {
		display: grid;
		gap: 0.5rem;
		padding-left: 1.25rem;
	}

	.prosa :global(li::marker) {
		color: var(--tinta);
	}

	.prosa :global(code) {
		padding: 0.1em 0.35em;
		border-radius: 4px;
		background: var(--fondo-3);
	}

	.vecinos {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
		margin-top: 3rem;
	}

	.vecino {
		display: grid;
		gap: 0.3rem;
		padding: 1.1rem 1.25rem;
		border: 1px solid var(--borde);
		border-radius: var(--radio);
		background: var(--fondo-2);
		text-decoration: none;
		transition:
			border-color 0.2s,
			translate 0.2s var(--curva);
	}

	.vecino:hover {
		border-color: var(--borde-fuerte);
		translate: 0 -2px;
	}

	.vecino--siguiente {
		grid-column: 2;
		text-align: right;
	}

	.vecino__dir {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-family: var(--mono);
		font-size: 0.75rem;
		color: var(--texto-3);
	}

	.vecino--siguiente .vecino__dir {
		justify-content: flex-end;
	}

	.vecino__dir :global(.simbolo) {
		width: 0.9rem;
		height: 0.9rem;
	}

	.vecino__titulo {
		font-weight: 600;
		color: var(--texto);
	}

	@media (max-width: 40rem) {
		.vecinos {
			grid-template-columns: 1fr;
		}
		.vecino--siguiente {
			grid-column: auto;
		}
	}
</style>
