---
import { perfil } from '../data/perfil';

const fecha = new Date(`${perfil.actualizado}T12:00:00`).toLocaleDateString('es-BO', { day: 'numeric', month: 'long', year: 'numeric' });
---

<footer class="pie">
	<div class="contenedor pie__fila">
		<p>
			<span class="pie__nombre">{perfil.nombre}</span>
			<span class="pie__nota">Escrito desde Santa Cruz de la Sierra, Bolivia, con ayuda de mis agentes.</span>
		</p>
		<p class="pie__meta">
			<a href={perfil.enlaces.repositorio}>código de esta página</a>
			<span aria-hidden="true">·</span>
			<span>actualizada el <time datetime={perfil.actualizado}>{fecha}</time></span>
		</p>
	</div>
</footer>

<style>
	.pie {
		margin-top: 2rem;
		padding-block: 2rem 2.5rem;
		border-top: 1px solid var(--borde);
		font-size: 0.875rem;
		color: var(--texto-3);
	}

	.pie__fila {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.75rem 2rem;
	}

	.pie__nombre {
		display: block;
		color: var(--texto-2);
		font-weight: 600;
	}

	.pie__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		gap: 0.5rem;
		font-family: var(--mono);
		font-size: 0.8125rem;
	}

	.pie__meta a {
		color: var(--texto-3);
	}

	.pie__meta a:hover {
		color: var(--texto);
	}
</style>
