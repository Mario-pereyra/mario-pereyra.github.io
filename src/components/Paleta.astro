---
// Paleta de comandos: Ctrl+K (⌘K en Mac) o «:». Navega a secciones y proyectos y ejecuta acciones.
// Sigue el patrón de combobox con lista (WAI-ARIA): el foco queda en el campo y las flechas mueven la opción activa.
import { getCollection } from 'astro:content';
import { perfil } from '../data/perfil';
import Simbolo from './Simbolo.astro';

const enInicio = Astro.url.pathname === '/';
const ancla = (id: string) => (enInicio ? `#${id}` : `/#${id}`);
const proyectos = (await getCollection('proyectos')).sort((a, b) => a.data.orden - b.data.orden);

type Opcion = { texto: string; pista?: string; href?: string; accion?: string; externo?: boolean; descarga?: boolean };
const grupos: { titulo: string; opciones: Opcion[] }[] = [
	{
		titulo: 'Ir a',
		opciones: [
			{ texto: 'Inicio', pista: '~', href: enInicio ? '#inicio' : '/' },
			{ texto: 'Sobre mí', pista: 'sobre-mi.md', href: ancla('sobre-mi') },
			{ texto: 'Experiencia', pista: 'git log', href: ancla('experiencia') },
			{ texto: 'Proyectos', pista: 'ls ~/proyectos', href: ancla('proyectos') },
			{ texto: 'Stack', pista: 'stack.yaml', href: ancla('stack') },
			{ texto: 'Formación', pista: 'formacion.md', href: ancla('formacion') },
			{ texto: 'Contacto', pista: 'contactar.sh', href: ancla('contacto') },
		],
	},
	{
		titulo: 'Proyectos',
		opciones: proyectos.map((p) => ({ texto: p.data.titulo, pista: `proyectos/${p.id}`, href: `/proyectos/${p.id}/` })),
	},
	{
		titulo: 'Acciones',
		opciones: [
			{ texto: 'Descargar CV', pista: 'PDF', href: perfil.cv, descarga: true },
			{ texto: 'Copiar mi correo', pista: 'portapapeles', accion: 'copiar-correo' },
			{ texto: 'Cambiar tema', pista: 'claro / oscuro', accion: 'tema' },
			{ texto: 'Abrir GitHub', pista: 'mario-pereyra', href: perfil.enlaces.github, externo: true },
			{ texto: 'Abrir LinkedIn', pista: 'mario-pereyra-justiniano', href: perfil.enlaces.linkedin, externo: true },
			{ texto: 'Ver el código de esta página', pista: 'GitHub', href: perfil.enlaces.repositorio, externo: true },
		],
	},
];
let n = 0;
---

<dialog class="paleta" aria-label="Paleta de comandos" data-paleta>
	<div class="paleta__caja">
		<div class="paleta__entrada">
			<span class="paleta__signo" aria-hidden="true">:</span>
			<input
				type="text"
				role="combobox"
				aria-expanded="true"
				aria-controls="paleta-lista"
				aria-autocomplete="list"
				aria-label="Buscar una sección, un proyecto o una acción"
				placeholder="Buscar una sección, un proyecto o una acción…"
				autocomplete="off"
				spellcheck="false"
				data-paleta-campo
			/>
			<kbd>Esc</kbd>
		</div>
		<ul class="paleta__lista" id="paleta-lista" role="listbox" aria-label="Resultados" data-paleta-lista>
			{
				grupos.map((grupo) => (
					<li role="presentation" class="paleta__grupo" data-grupo>
						<span class="paleta__titulo" aria-hidden="true">
							{grupo.titulo}
						</span>
						<ul role="presentation">
							{grupo.opciones.map((o) => (
								<li
									role="option"
									id={`paleta-opcion-${n++}`}
									class="paleta__opcion"
									aria-selected="false"
									data-opcion
									data-texto={`${o.texto} ${o.pista ?? ''}`.toLowerCase()}
									data-href={o.href}
									data-accion={o.accion}
									data-externo={o.externo ? '' : undefined}
									data-descarga={o.descarga ? '' : undefined}
								>
									<Simbolo nombre={o.externo ? 'externo' : o.descarga ? 'descargar' : o.accion ? 'terminal' : 'flecha'} />
									<span class="paleta__texto">{o.texto}</span>
									{o.pista && <span class="paleta__pista">{o.pista}</span>}
								</li>
							))}
						</ul>
					</li>
				))
			}
		</ul>
		<p class="paleta__vacio" data-paleta-vacio hidden>Sin resultados. Prueba con «cv», «proyectos» o «correo».</p>
		<p class="paleta__ayuda" aria-hidden="true">
			<span><kbd>↑</kbd><kbd>↓</kbd> moverse</span>
			<span><kbd>Enter</kbd> abrir</span>
			<span><kbd>Esc</kbd> cerrar</span>
		</p>
	</div>
</dialog>

<style>
	.paleta {
		width: min(100% - 2rem, 38rem);
		max-height: min(80dvh, 34rem);
		margin: 12dvh auto auto;
		padding: 0;
		border: 1px solid var(--borde-fuerte);
		border-radius: var(--radio);
		background: var(--fondo-2);
		color: var(--texto);
		box-shadow: var(--sombra);
		overflow: hidden;
	}

	.paleta[open] {
		display: flex;
	}

	@media (prefers-reduced-motion: no-preference) {
		.paleta[open] {
			animation: entrar 0.18s var(--curva);
		}
		.paleta[open]::backdrop {
			animation: velo 0.18s ease-out;
		}
	}

	@keyframes entrar {
		from {
			opacity: 0;
			translate: 0 -8px;
			scale: 0.98;
		}
	}

	@keyframes velo {
		from {
			opacity: 0;
		}
	}

	.paleta::backdrop {
		background: rgb(10 10 10 / 0.55);
		backdrop-filter: blur(3px);
	}

	.paleta__caja {
		display: flex;
		flex-direction: column;
		width: 100%;
		min-height: 0;
	}

	.paleta__entrada {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.75rem 1rem;
		border-bottom: 1px solid var(--borde);
	}

	.paleta__signo {
		font-family: var(--mono);
		font-weight: 700;
		color: var(--amarillo);
	}

	.paleta__entrada input {
		flex: 1;
		min-width: 0;
		border: 0;
		background: none;
		color: var(--texto);
		font: 1rem/1.5 var(--mono);
		outline: none;
	}

	.paleta__entrada input::placeholder {
		color: var(--texto-3);
	}

	.paleta__lista {
		flex: 1;
		overflow-y: auto;
		overscroll-behavior: contain;
		padding: 0.4rem;
		list-style: none;
	}

	.paleta__lista ul {
		list-style: none;
	}

	.paleta__titulo {
		display: block;
		padding: 0.6rem 0.6rem 0.3rem;
		font-family: var(--mono);
		font-size: 0.6875rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--texto-3);
	}

	.paleta__opcion {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		min-height: 2.6rem;
		padding: 0.45rem 0.6rem;
		border-radius: var(--radio-chico);
		cursor: pointer;
		color: var(--texto-2);
	}

	.paleta__opcion :global(.simbolo) {
		width: 1rem;
		height: 1rem;
		flex: none;
		color: var(--texto-3);
	}

	.paleta__texto {
		flex: 1;
	}

	.paleta__pista {
		font-family: var(--mono);
		font-size: 0.75rem;
		color: var(--texto-3);
	}

	.paleta__opcion[aria-selected='true'] {
		background: var(--fondo-3);
		color: var(--texto);
		box-shadow: inset 2px 0 0 var(--amarillo);
	}

	.paleta__opcion[aria-selected='true'] :global(.simbolo) {
		color: var(--amarillo);
	}

	.paleta__vacio {
		padding: 1.5rem 1rem;
		color: var(--texto-3);
		text-align: center;
	}

	.paleta__ayuda {
		display: flex;
		gap: 1rem;
		padding: 0.55rem 1rem;
		border-top: 1px solid var(--borde);
		font-size: 0.75rem;
		color: var(--texto-3);
	}

	.paleta__ayuda kbd {
		margin-right: 0.2rem;
	}

	@media (hover: none) {
		.paleta__ayuda {
			display: none;
		}
	}
</style>

<script>
	import { avisar, cambiarTema, copiarCorreo } from '../scripts/acciones';

	const paleta = document.querySelector<HTMLDialogElement>('[data-paleta]')!;
	const campo = paleta.querySelector<HTMLInputElement>('[data-paleta-campo]')!;
	const vacio = paleta.querySelector<HTMLElement>('[data-paleta-vacio]')!;
	const opciones = [...paleta.querySelectorAll<HTMLElement>('[data-opcion]')];
	const grupos = [...paleta.querySelectorAll<HTMLElement>('[data-grupo]')];
	let visibles = opciones;
	let activa = 0;

	// Sin tildes ni mayúsculas, para que «formacion» encuentre «Formación».
	const normalizar = (texto: string) => texto.normalize('NFD').replace(/\p{Diacritic}/gu, '').toLowerCase();

	function marcar(indice: number) {
		visibles.forEach((o) => o.setAttribute('aria-selected', 'false'));
		if (!visibles.length) {
			campo.removeAttribute('aria-activedescendant');
			return;
		}
		activa = (indice + visibles.length) % visibles.length;
		const opcion = visibles[activa];
		opcion.setAttribute('aria-selected', 'true');
		campo.setAttribute('aria-activedescendant', opcion.id);
		opcion.scrollIntoView({ block: 'nearest' });
	}

	function filtrar() {
		const consulta = normalizar(campo.value.trim());
		const palabras = consulta.split(/\s+/).filter(Boolean);
		visibles = [];
		for (const opcion of opciones) {
			const texto = normalizar(opcion.dataset.texto ?? '');
			const coincide = palabras.every((p) => texto.includes(p));
			opcion.hidden = !coincide;
			if (coincide) visibles.push(opcion);
		}
		for (const grupo of grupos) grupo.hidden = !grupo.querySelector('[data-opcion]:not([hidden])');
		vacio.hidden = visibles.length > 0;
		marcar(0);
	}

	function abrir() {
		if (paleta.open) return;
		campo.value = '';
		filtrar();
		paleta.showModal();
		document.documentElement.dataset.modo = 'comando';
		campo.focus();
	}

	function cerrar() {
		if (paleta.open) paleta.close();
	}

	async function ejecutar(opcion: HTMLElement | undefined) {
		if (!opcion) return;
		const { href, accion } = opcion.dataset;
		cerrar();
		if (accion === 'copiar-correo') return copiarCorreo();
		if (accion === 'tema') return cambiarTema();
		if (!href) return;
		if ('descarga' in opcion.dataset) {
			const enlace = Object.assign(document.createElement('a'), { href, download: '' });
			enlace.click();
			return avisar('Descargando el CV');
		}
		if ('externo' in opcion.dataset) {
			window.open(href, '_blank', 'noopener');
			return;
		}
		location.href = href;
	}

	paleta.addEventListener('close', () => {
		delete document.documentElement.dataset.modo;
	});

	// Clic fuera de la caja (en el fondo del diálogo) cierra.
	paleta.addEventListener('click', (evento) => {
		if (evento.target === paleta) cerrar();
	});

	campo.addEventListener('input', filtrar);
	campo.addEventListener('keydown', (evento) => {
		if (evento.key === 'ArrowDown') {
			evento.preventDefault();
			marcar(activa + 1);
		} else if (evento.key === 'ArrowUp') {
			evento.preventDefault();
			marcar(activa - 1);
		} else if (evento.key === 'Home' && evento.ctrlKey) {
			marcar(0);
		} else if (evento.key === 'Enter') {
			evento.preventDefault();
			ejecutar(visibles[activa]);
		}
	});

	for (const opcion of opciones) {
		opcion.addEventListener('click', () => ejecutar(opcion));
		opcion.addEventListener('pointermove', () => {
			const i = visibles.indexOf(opcion);
			if (i !== activa) marcar(i);
		});
	}

	for (const disparador of document.querySelectorAll('[data-abrir-paleta]')) disparador.addEventListener('click', abrir);

	document.addEventListener('keydown', (evento) => {
		const escribiendo = evento.target instanceof HTMLElement && evento.target.closest('input, textarea, [contenteditable]');
		if ((evento.key === 'k' || evento.key === 'K') && (evento.ctrlKey || evento.metaKey)) {
			evento.preventDefault();
			paleta.open ? cerrar() : abrir();
		} else if (evento.key === ':' && !escribiendo && !paleta.open) {
			evento.preventDefault();
			abrir();
		}
	});
</script>
