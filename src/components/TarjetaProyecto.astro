---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { tiposDeProyecto } from '../data/perfil';
import { iconoDe } from '../data/stack';
import Icono from './Icono.astro';
import Simbolo from './Simbolo.astro';

interface Props {
	proyecto: CollectionEntry<'proyectos'>;
}

const { proyecto } = Astro.props;
const { titulo, resumen, tipo, equipo, periodo, stack, demo, codigo, codigoPrivado, captura, capturaAlt } = proyecto.data;
const tinta = { personal: 'rosa', familiar: 'amarillo', universidad: 'azul' }[tipo];
const conIcono = stack.filter((n) => iconoDe(n));
const sinIcono = stack.filter((n) => !iconoDe(n));
const detalle = `/proyectos/${proyecto.id}/`;
---

<article class="tarjeta revelar" data-tipo={tipo} style={`--tinta: var(--${tinta})`}>
	<div class="tarjeta__vista" aria-hidden={captura ? undefined : 'true'}>
		<span class="tarjeta__ruta">~/proyectos/{proyecto.id}</span>
		{
			captura ? (
				<div class="celular">
					<Image src={captura} alt={capturaAlt ?? ''} widths={[200, 300, 400]} sizes="200px" loading="lazy" />
				</div>
			) : (
				<ul class="tarjeta__arte">
					{conIcono.slice(0, 4).map((n) => (
						<li>
							<img src={`/iconos/${iconoDe(n)}-oscuro.svg`} alt="" width="48" height="48" loading="lazy" />
						</li>
					))}
				</ul>
			)
		}
	</div>

	<div class="tarjeta__cuerpo">
		<p class="tarjeta__meta">
			<span class="etiqueta tarjeta__tipo">{tiposDeProyecto[tipo]}{equipo && ` · ${equipo}`}</span>
			<span>{periodo}</span>
		</p>
		<h3 class="tarjeta__titulo">
			<a href={detalle} style={`view-transition-name: proyecto-${proyecto.id}`}>{titulo}</a>
		</h3>
		<p class="tarjeta__resumen">{resumen}</p>

		<div class="tarjeta__stack">
			<ul class="iconos" aria-label="Tecnologías">
				{
					conIcono.map((n) => (
						<li>
							<Icono id={iconoDe(n)!} nombre={n} tam="1.85rem" />
						</li>
					))
				}
			</ul>
			{
				sinIcono.length > 0 && (
					<ul class="chips">
						{sinIcono.map((n) => (
							<li class="chip">{n}</li>
						))}
					</ul>
				)
			}
		</div>

		<p class="tarjeta__enlaces">
			{
				demo && (
					<a href={demo} rel="noopener">
						<Simbolo nombre="externo" /> demo
					</a>
				)
			}
			{
				codigo.map((c) => (
					<a href={c.url} rel="noopener">
						<Simbolo nombre="codigo" /> {c.etiqueta.toLowerCase()}
					</a>
				))
			}
			{
				codigoPrivado && (
					<span class="tarjeta__privado">
						<Simbolo nombre="candado" /> código privado
					</span>
				)
			}
			<a class="tarjeta__detalle" href={detalle} aria-label={`Ver el detalle de ${titulo}`}>
				detalle <Simbolo nombre="flecha" />
			</a>
		</p>
	</div>
</article>

<style>
	.tarjeta {
		position: relative;
		display: flex;
		flex-direction: column;
		border: 1px solid var(--borde);
		border-radius: var(--radio);
		background: var(--fondo-2);
		overflow: hidden;
		transition:
			border-color 0.2s,
			translate 0.25s var(--curva),
			box-shadow 0.25s;
	}

	.tarjeta:hover {
		border-color: color-mix(in srgb, var(--tinta) 55%, var(--borde));
		translate: 0 -3px;
		box-shadow: var(--sombra);
	}

	.tarjeta__vista {
		position: relative;
		height: 13.5rem;
		overflow: hidden;
		border-bottom: 1px solid var(--borde);
		background-color: color-mix(in srgb, var(--tinta) 9%, var(--fondo-3));
		background-image: radial-gradient(color-mix(in srgb, var(--tinta) 45%, transparent) 1.1px, transparent 1.4px);
		background-size: 14px 14px;
	}

	.tarjeta__ruta {
		position: absolute;
		left: 0.9rem;
		top: 0.75rem;
		z-index: 1;
		padding: 0.1rem 0.45rem;
		border-radius: 5px;
		background: var(--fondo-2);
		font-family: var(--mono);
		font-size: 0.75rem;
		color: var(--texto-3);
	}

	.celular {
		position: absolute;
		left: 50%;
		top: 2.6rem;
		width: 11.5rem;
		translate: -50% 0;
		rotate: -4deg;
		padding: 6px;
		border-radius: 1.6rem 1.6rem 0 0;
		background: #111;
		box-shadow: 0 18px 40px -12px rgb(0 0 0 / 0.55);
		transition:
			translate 0.4s var(--curva),
			rotate 0.4s var(--curva);
	}

	.celular :global(img) {
		width: 100%;
		height: auto;
		border-radius: 1.2rem 1.2rem 0 0;
	}

	.tarjeta:hover .celular {
		translate: -50% -0.9rem;
		rotate: 0deg;
	}

	.tarjeta__arte {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.9rem;
		list-style: none;
	}

	.tarjeta__arte li {
		width: 3.4rem;
		height: 3.4rem;
		border-radius: 22%;
		box-shadow: 0 10px 24px -10px rgb(0 0 0 / 0.5);
		transition: translate 0.35s var(--curva);
	}

	.tarjeta__arte li:nth-child(even) {
		translate: 0 0.6rem;
	}

	.tarjeta:hover .tarjeta__arte li {
		translate: 0 -0.3rem;
	}

	.tarjeta:hover .tarjeta__arte li:nth-child(even) {
		translate: 0 0.3rem;
	}

	.tarjeta__arte img {
		width: 100%;
		height: 100%;
	}

	.tarjeta__cuerpo {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: 0.8rem;
		padding: 1.25rem 1.35rem 1.2rem;
	}

	.tarjeta__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem 0.75rem;
		font-family: var(--mono);
		font-size: 0.75rem;
		color: var(--texto-3);
	}

	.tarjeta__tipo {
		border-color: color-mix(in srgb, var(--tinta) 45%, var(--borde));
		color: var(--texto);
	}

	.tarjeta__titulo {
		font-size: 1.375rem;
	}

	.tarjeta__titulo a {
		color: var(--texto);
		text-decoration: none;
	}

	/* Toda la tarjeta lleva al detalle; los demás enlaces y los íconos quedan por encima. */
	.tarjeta__titulo a::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.tarjeta__resumen {
		color: var(--texto-2);
		font-size: 0.975rem;
	}

	.tarjeta__stack {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 0.75rem;
		margin-top: auto;
		padding-top: 0.25rem;
	}

	.tarjeta__stack .iconos,
	.tarjeta__enlaces a {
		position: relative;
		z-index: 1;
	}

	.tarjeta__stack .iconos {
		gap: 0.4rem;
	}

	.tarjeta__enlaces {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.25rem 1rem;
		padding-top: 0.85rem;
		border-top: 1px dashed var(--borde);
		font-family: var(--mono);
		font-size: 0.8125rem;
	}

	.tarjeta__enlaces a,
	.tarjeta__privado {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		min-height: 2rem;
		color: var(--texto-2);
		text-decoration: none;
	}

	.tarjeta__enlaces a:hover {
		color: var(--tinta);
	}

	.tarjeta__enlaces :global(.simbolo) {
		width: 0.95rem;
		height: 0.95rem;
	}

	.tarjeta__privado {
		color: var(--texto-3);
	}

	.tarjeta__detalle {
		margin-left: auto;
		color: var(--texto) !important;
	}

	.tarjeta__detalle :global(.simbolo) {
		transition: translate 0.2s var(--curva);
	}

	.tarjeta:hover .tarjeta__detalle :global(.simbolo) {
		translate: 3px 0;
	}
</style>
