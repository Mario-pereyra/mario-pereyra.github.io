---
import '../styles/global.css';
import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';
import { perfil } from '../data/perfil';

interface Props {
	titulo: string;
	descripcion: string;
	jsonLd?: Record<string, unknown>;
}

const { titulo, descripcion, jsonLd } = Astro.props;
const canonica = new URL(Astro.url.pathname, Astro.site);
const imagen = new URL('/og.png', Astro.site);
const altImagen = `${perfil.nombre}: ${perfil.rol}`;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="light dark" />
		<title>{titulo}</title>
		<meta name="description" content={descripcion} />
		<link rel="canonical" href={canonica} />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="icon" href="/favicon-96.png" sizes="96x96" type="image/png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="sitemap" href="/sitemap-index.xml" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={perfil.nombre} />
		<meta property="og:locale" content="es_BO" />
		<meta property="og:title" content={titulo} />
		<meta property="og:description" content={descripcion} />
		<meta property="og:url" content={canonica} />
		<meta property="og:image" content={imagen} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="627" />
		<meta property="og:image:alt" content={altImagen} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="generator" content={Astro.generator} />

		<!-- Aplica el tema guardado antes de pintar, para que no parpadee. -->
		<script is:inline>
			try {
				const tema = localStorage.getItem('tema');
				if (tema === 'claro' || tema === 'oscuro') document.documentElement.dataset.tema = tema;
			} catch {}
		</script>
		{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
	</head>
	<body>
		<a class="saltar" href="#contenido">Saltar al contenido</a>
		<Cabecera />
		<main id="contenido">
			<slot />
		</main>
		<Pie />
		<script>
			const raiz = document.documentElement;
			const oscuroDelSistema = window.matchMedia('(prefers-color-scheme: dark)');
			const boton = document.querySelector<HTMLButtonElement>('[data-cambiar-tema]');

			function temaActual(): 'claro' | 'oscuro' {
				const tema = raiz.dataset.tema;
				if (tema === 'claro' || tema === 'oscuro') return tema;
				return oscuroDelSistema.matches ? 'oscuro' : 'claro';
			}

			function actualizarBoton() {
				boton?.setAttribute('aria-pressed', String(temaActual() === 'oscuro'));
			}

			if (boton) {
				boton.hidden = false;
				boton.addEventListener('click', () => {
					const nuevo = temaActual() === 'oscuro' ? 'claro' : 'oscuro';
					raiz.dataset.tema = nuevo;
					try {
						localStorage.setItem('tema', nuevo);
					} catch {}
					actualizarBoton();
				});
				oscuroDelSistema.addEventListener('change', actualizarBoton);
				actualizarBoton();
			}

			// Arma el correo en el navegador: en el HTML no aparece completo.
			for (const enlace of document.querySelectorAll<HTMLAnchorElement>('[data-correo-usuario]')) {
				const direccion = `${enlace.dataset.correoUsuario}@${enlace.dataset.correoDominio}`;
				enlace.href = `mailto:${direccion}`;
				for (const texto of document.querySelectorAll('[data-correo-texto]')) texto.textContent = direccion;
			}
		</script>
	</body>
</html>
